<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Campus Activity Registration System</display-name>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Auth Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.xiaoyuan.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Activity Listing Servlet -->
    <servlet>
        <servlet-name>ActivityServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.ActivityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ActivityServlet</servlet-name>
        <url-pattern>/activities/*</url-pattern>
    </servlet-mapping>

    <!-- Activity Management Servlet (Organizer/Admin) -->
    <servlet>
        <servlet-name>ActivityManageServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.ActivityManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ActivityManageServlet</servlet-name>
        <url-pattern>/manage-activities</url-pattern>
        <url-pattern>/manage-activities/*</url-pattern>
    </servlet-mapping>

    <!-- Registration Servlet -->
    <servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.RegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/registrations</url-pattern>
        <url-pattern>/registrations/*</url-pattern>
    </servlet-mapping>

    <!-- Review Servlet -->
    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/reviews</url-pattern>
        <url-pattern>/reviews/*</url-pattern>
    </servlet-mapping>

    <!-- Self Check-in Servlet (Student) -->
    <servlet>
        <servlet-name>SelfCheckInServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.SelfCheckInServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SelfCheckInServlet</servlet-name>
        <url-pattern>/self-checkin</url-pattern>
    </servlet-mapping>

    <!-- Check-in Servlet -->
    <servlet>
        <servlet-name>CheckInServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.CheckInServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckInServlet</servlet-name>
        <url-pattern>/checkin</url-pattern>
        <url-pattern>/checkin/*</url-pattern>
    </servlet-mapping>

    <!-- Points Servlet -->
    <servlet>
        <servlet-name>PointsServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.PointsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PointsServlet</servlet-name>
        <url-pattern>/points</url-pattern>
        <url-pattern>/points/*</url-pattern>
    </servlet-mapping>

    <!-- Statistics Servlet -->
    <servlet>
        <servlet-name>StatisticsServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.StatisticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatisticsServlet</servlet-name>
        <url-pattern>/statistics</url-pattern>
    </servlet-mapping>

    <!-- User Management Servlet (Admin) -->
    <servlet>
        <servlet-name>UserManageServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.UserManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManageServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
        <url-pattern>/admin/users/*</url-pattern>
    </servlet-mapping>

    <!-- Category Management Servlet (Admin) -->
    <servlet>
        <servlet-name>CategoryServlet</servlet-name>
        <servlet-class>com.xiaoyuan.servlet.CategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryServlet</servlet-name>
        <url-pattern>/admin/categories</url-pattern>
        <url-pattern>/admin/categories/*</url-pattern>
    </servlet-mapping>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/common/error.jsp</location>
    </error-page>

</web-app>
